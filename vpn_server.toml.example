# vpn-rs server configuration example
#
# Usage: vpn-rs server -c vpn_server.toml
#        vpn-rs server --default-config   (~/.config/vpn-rs/vpn_server.toml)
#
# vpn-rs is responsible for VPN tunneling ONLY. It binds a loopback-only
# socket; a separate tunnel process must run on this host, forward this
# loopback port across the network, and provide the encryption + authentication.
# Examples: tunnel-rs (https://github.com/andrewtheguy/tunnel-rs),
# duopipe (https://github.com/andrewtheguy/duopipe), or any loopback forwarder.
# The VPN server is never reachable directly — only through the local tunnel.

# Required: validates the config matches the CLI command.
role = "vpnserver"

[server]
# ============================================================================
# Transport (optional)
# ============================================================================
# Transport carrying VPN traffic: "tcp" (default) or "udp". TCP carries each
# client over one connection; UDP frames each packet into a datagram. The CLI
# --transport flag overrides this when set, and the tunnel on this host must
# forward the same protocol.
# transport = "tcp"

# ============================================================================
# Loopback listen address (the local tunnel forwards to it)
# ============================================================================
# MUST be loopback: 127.0.0.0/8 (IPv4), ::1 (IPv6), or IPv4-mapped loopback.
# Any other address is rejected at startup. Default: 127.0.0.1:5555
listen = "127.0.0.1:5555"

# ============================================================================
# VPN Network Configuration
# ============================================================================
# Choose the VPN address family. At least one of 'network' (IPv4) or
# 'network6' (IPv6) is REQUIRED:
#   - IPv4-only:  set 'network' only
#   - IPv6-only:  set 'network6' only
#   - Dual-stack: set both 'network' and 'network6'
#
# These are the *inner* VPN addresses handed to clients; they are independent of
# the loopback transport above.

# IPv4 VPN network CIDR. Clients are assigned IPs from this network.
network = "10.0.0.0/24"

# Server's VPN IP (optional, defaults to the first host, e.g. 10.0.0.1).
# server_ip = "10.0.0.1"

# IPv6 VPN network CIDR. Set this (and omit 'network') for IPv6-only, or set it
# with 'network' for dual-stack. Must be /126 or wider. One /128 is assigned per
# client, sequentially (server gets ::1).
# network6 = "fd00::/64"
# server_ip6 = "fd00::1"

# ============================================================================
# Tunables (all optional)
# ============================================================================

# TUN MTU (576-9216, default 1440).
# mtu = 1440

# Maximum number of connected clients (default 254).
# max_clients = 254

# Seconds without any datagram from a client before it is reaped and its IP
# released (UDP has no connection teardown). Must be >= 15. Default 60.
# client_timeout_secs = 60

# Maximum UDP datagram payload to emit (576..=65507, default 65507). Offload
# (GSO) super-frames larger than this are segmented before sending. Lower this
# only if your tunnel cannot carry large UDP datagrams. (UDP transport only.)
# max_datagram_size = 65507

# Drop packets for a slow client instead of applying backpressure (default false).
# drop_on_full = false

# Per-client outbound buffer / aggregate TUN-writer buffer (defaults 1024 / 512).
# client_channel_size = 1024
# tun_writer_channel_size = 512

# Inbound worker queue: data datagrams the UDP recv loop hands off for parsing /
# anti-spoof / TUN forwarding (default 1024). The recv loop drops (and counts) when
# this is full instead of stalling, so it keeps draining the kernel socket buffer.
# (UDP transport only.)
# inbound_worker_channel_size = 1024

# Kernel socket buffers (SO_RCVBUF / SO_SNDBUF) in bytes (65536..=1073741824,
# defaults 4 MiB each). Large buffers let the kernel absorb multi-Gbit bursts
# instead of silently dropping data (which surfaces as inner-TCP retransmits).
# NOTE: Linux caps the request at net.core.rmem_max / net.core.wmem_max; raise
# those sysctls to actually use a larger buffer. A startup log reports the
# requested-vs-applied size and warns if the kernel capped it.
# recv_buffer_size = 4194304
# send_buffer_size = 4194304

# Disable inter-client source-IP spoofing checks (default false). With no
# transport-level auth here, leave this on unless the tunnel already isolates
# clients from each other.
# disable_spoofing_check = false
