# vpn-rs TEST-MODE server configuration example
#
# Usage: vpn-rs server --test-mode -c vpn_server_test.toml
#
# TEST MODE ONLY. Unlike the normal server, a test-mode server may bind a
# NON-loopback address so you can run the VPN directly between two hosts (or two
# interfaces) without an external tunnel. There is no transport encryption or
# authentication in this path — use it only for testing on trusted networks.
#
# A test-mode server requires BOTH:
#   1. the --test-mode CLI flag, and
#   2. role = "testvpnserver" below (a normal "vpnserver" role is rejected).
# On startup the server generates a RANDOM test token and logs it; every client
# must present it via --test-token, which prevents an unintended client from
# activating against the test server. Test and non-test instances cannot
# interoperate.

# Required: must be "testvpnserver" in test mode.
role = "testvpnserver"

[server]
# Listen address. In test mode this MAY be a non-loopback address so remote
# test clients can reach it directly. Default: 127.0.0.1:5555
listen = "0.0.0.0:5555"

# VPN network configuration — identical rules to the normal server.
# At least one of 'network' (IPv4) or 'network6' (IPv6) is REQUIRED.
network = "10.0.0.0/24"
# server_ip = "10.0.0.1"
# network6 = "fd00::/64"
# server_ip6 = "fd00::1"

# All other tunables (mtu, max_clients, client_timeout_secs, max_datagram_size,
# drop_on_full, channel sizes, disable_spoofing_check) behave exactly as in
# vpn_server.toml.example.
